APP_HOST=127.0.0.1
APP_PORT=3000
# Required. OIDC issuer identifier written into JWT iss claims and the Discovery document.
# Must be an absolute URL with no path, query, or fragment (e.g. https://auth.example.com).
# Cannot be derived from the request Host or reverse proxy headers; must be a fixed value.
# Service startup fails if this variable is unset or empty.
APP_ISSUER=https://auth.example.com
# Optional. Bearer token for admin APIs. Leave unset to disable all admin API access.
# Exception: the first-owner bootstrap endpoint is public when no owner exists.
# A startup warning is logged when this is unset or empty.
ADMIN_TOKEN=change-this-admin-token
AUTH_ENCRYPTION_KEY=base64-encoded-32-byte-key
# Optional rotation ring: kid=<key-id>:<standard-base64-key>,kid=<old-id>:<standard-base64-key>
# AUTH_ENCRYPTION_KEYS=kid=current:base64-encoded-32-byte-key,kid=previous:base64-old-key
# AUTH_ENCRYPTION_ACTIVE_KID=current
KEY_DIRECTORY=data/keys
KEY_ROTATION_GRACE_SECONDS=604800
COOKIE_SECURE=false
# Development-only compatibility; keep disabled in production.
OAUTH_SESSION_HEADER_ENABLED=false
# Only explicit non-browser API requests may receive a session token in JSON.
SESSION_TOKEN_RESPONSE_ENABLED=false
WEBAUTHN_RP_ID=127.0.0.1
WEBAUTHN_ORIGIN=http://127.0.0.1:3000
DATABASE_URL=postgres://chenxing:chenxing@127.0.0.1:5432/chenxing_auth
REDIS_URL=redis://127.0.0.1:6379
# Redis outage behavior for authentication failure limiting: fail-closed or fail-open.
AUTH_LIMITER_FAILURE_POLICY=fail-closed
# Requests without trusted ConnectInfo: reject in production or skip only the IP dimension.
AUTH_LIMITER_MISSING_SOURCE_IP=reject
POSTGRES_DB=chenxing_auth
POSTGRES_USER=chenxing
POSTGRES_PASSWORD=change-this-database-password
SESSION_TTL_SECONDS=604800
OAUTH_CLIENT_MAX_REDIRECT_URIS=10
OAUTH_CLIENT_MAX_REDIRECT_URI_LENGTH=2048
OAUTH_CLIENT_MAX_SCOPES=32
OAUTH_CLIENT_MAX_SCOPE_LENGTH=64
RUST_LOG=chenxing_auth=debug,tower_http=debug
