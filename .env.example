APP_HOST=127.0.0.1
APP_PORT=3000
# Maximum time for a matched application or system API route to produce a response (seconds).
# Health checks keep their own 2s dependency budget; the static SPA fallback is not wrapped.
# Timeout response format is path-aware (Issues #423, #451): /oauth/* returns RFC 6749
# 503 temporarily_unavailable; other matched routes return 504 request_timeout JSON envelope.
# REQUEST_TIMEOUT_SECONDS=30
# Total time to finish in-flight HTTP connections after SIGTERM or a critical
# worker failure (seconds). Static SPA/asset responses are not wrapped by
# REQUEST_TIMEOUT_SECONDS, so a client that stops reading the body can otherwise
# block process exit. When this deadline elapses, remaining connections are
# aborted and a diagnostic warning is logged. Worker drain starts at the same
# time and keeps its own 10s bound; it is not gated on an unbounded server.await.
# HTTP_GRACEFUL_DRAIN_SECONDS=15
# APP_ISSUER is intentionally absent from this new-deployment template.
# The runtime OIDC issuer is persisted in PostgreSQL app_settings. Bootstrap the ID=1 Owner,
# then write a fixed absolute URL from Owner settings; the current process hot-reloads it.
# Older deployments may retain APP_ISSUER as a compatibility import when the database has no
# issuer yet. The database remains authoritative afterward, and the value is never derived
# from the request Host or a reverse proxy header.
# Optional. Bearer token for the admin API automation channel (owner-equivalent
# permissions, no user id, exempt from browser CSRF).
# Leaving it unset disables the entire initialized admin API surface.
# Both Bearer and authenticated browser Session requests are rejected with
# 403 admin_disabled; the first-owner bootstrap endpoint stays public while no owner exists.
# A startup warning is logged when this is unset or empty.
# Generate a strong value with: openssl rand -base64 32
ADMIN_TOKEN=
AUTH_ENCRYPTION_KEY=base64-encoded-32-byte-key
# Optional rotation ring: kid=<key-id>:<standard-base64-key>,kid=<old-id>:<standard-base64-key>
# AUTH_ENCRYPTION_KEYS=kid=current:base64-encoded-32-byte-key,kid=previous:base64-old-key
# AUTH_ENCRYPTION_ACTIVE_KID=current
KEY_DIRECTORY=data/keys
# Optional. Directory holding the built frontend bundle (Vite web/dist). Defaults
# to the relative path web/dist, which only resolves when the process runs from
# the repository root. Container images ship the bundle and set this themselves,
# so leave it unset unless you run the binary from an unrelated working directory.
# Resolved and validated at startup: the path is canonicalized and must be a real
# frontend build artifact root (index.html present, plus every asset the embedded
# SPA shell references). Startup fails when it is empty, missing, points at the
# filesystem root, at or above the working directory, or overlaps KEY_DIRECTORY —
# serving those would expose .env and signing keys. There is no fallback to the
# working directory. The `migrate` and `audit-archive` subcommands do not serve
# static files and are unaffected.
# WEB_DIST_DIR=/usr/local/share/chenxing-auth/web/dist
# Retain old signing keys long enough to validate every issued token. Supported range: 1..2592000 seconds (30 days).
KEY_ROTATION_GRACE_SECONDS=604800
# Clock-skew tolerance between instances sharing the key directory (Issue #316).
# retired_at is written by the retiring instance's clock; a fast-clock instance must
# not reclaim shared key files before the real retention window closes. The window
# closes at retired_at + grace + this value. Default 3600 (1h); must be <= KEY_ROTATION_GRACE_SECONDS.
# Single-instance deployments may set 0.
KEY_ROTATION_SKEW_ALLOWANCE_SECONDS=3600
# Wait after publishing a new public key to JWKS before it starts signing (Issue #454).
# Covers JWKS Cache-Control max-age=60 plus one 5s cross-instance sync. Production
# range is 65..300 and must be <= KEY_ROTATION_GRACE_SECONDS. In-flight rotations
# keep the persisted activate_at; only internal test constructors may use 0.
KEY_ACTIVATION_DELAY_SECONDS=65
# Browser Cookie transport mode. Keep true for HTTPS and every non-loopback deployment.
# Set false only for explicit local HTTP development on localhost/127.0.0.1/::1.
# Production Secure cookies (session, CSRF, external OAuth state) use __Host- names
# with Path=/ and no Domain; COOKIE_SECURE=false never applies that production name.
# dev-env.sh keeps this setting for local browser sessions. A legacy APP_ISSUER may still
# normalize it for older development environments; new environments default to true.
# Set false only for explicit loopback HTTP development.
COOKIE_SECURE=true
# Development-only compatibility; keep disabled in production.
OAUTH_SESSION_HEADER_ENABLED=false
# Only explicit non-browser API requests may receive a session token in JSON.
SESSION_TOKEN_RESPONSE_ENABLED=false
# Development-only switch (Issue #343): allow external provider endpoints on
# loopback hosts (localhost / 127.0.0.0/8 / ::1) including plaintext http, for
# local IdP integration testing. Defaults to false and MUST stay false in
# production: the server sends the decrypted client secret and user access
# tokens to these endpoints, which is the admin-controllable egress path the
# production boundary exists to close.
OAUTH_PROVIDER_LOOPBACK_ENABLED=false
# WebAuthn defaults follow the persisted runtime Issuer: RP ID uses its host and
# origin uses its root URL. Explicit overrides remain available, but are never
# inferred from request Host or reverse-proxy headers. Keep the generic template
# unpinned so a later Issuer configuration can supply both values.
# WEBAUTHN_RP_ID=auth.example.com
# WEBAUTHN_ORIGIN=https://auth.example.com
# Explicit loopback HTTP overrides live in .env.loopback.example.
# Runtime database connection. Must use a role that cannot UPDATE/DELETE/TRUNCATE
# audit tables; the migrate command creates and configures chenxing_runtime.
DATABASE_URL=postgres://chenxing_runtime:chenxing@127.0.0.1:5432/chenxing_auth
# Migration/owner connection. REQUIRED: the migrate command refuses to run when
# this role is the same as the runtime role, because PostgreSQL grants a table
# owner every privilege implicitly, so the baseline REVOKE on the audit
# tables cannot restrict it. Sharing one role silently reduces audit
# append-only to the trigger alone, whose archive bypass is a session GUC any
# session can set. See AUDIT_ROLE_SEPARATION below for the explicit escape hatch.
MIGRATION_DATABASE_URL=postgres://chenxing:chenxing@127.0.0.1:5432/chenxing_auth
# Note: the runtime role needs UPDATE on the users id sequence, because owner
# bootstrap calls setval to start the first Owner at id 1. The baseline grants
# exactly that one sequence; audit sequences stay read-only for the runtime role.
# Audit append-only role isolation policy for migrate and web startup (issues #281/#427).
#   require            (default) migrate fails unless the runtime role provably
#                      cannot UPDATE/DELETE/TRUNCATE the audit tables. The check
#                      queries has_table_privilege, so owner-implicit privileges
#                      and superuser bypass are both caught.
#   allow-single-role  Explicitly accept a trigger-only audit boundary. Every
#                      migrate run then logs a loud warning. Never use this in
#                      production; it exists so an existing single-role
#                      development database keeps working.
# AUDIT_ROLE_SEPARATION=require
# Web startup performs the same live privilege check before binding its listener.
# Whether migrate manages the chenxing_runtime password. Default: true, and even
# then migrate first tries to log in with DATABASE_URL and leaves the password
# untouched when it already works. Only SQLSTATE 28P01 (invalid_password)
# resets the role; 28000 and other class-28 errors fail-safe without ALTER ROLE.
# Set false when an external secret store owns that credential;
# migrate then never issues ALTER ROLE ... PASSWORD.
# MIGRATION_MANAGE_RUNTIME_PASSWORD=true
REDIS_URL=redis://127.0.0.1:6379
# Required for new deployments. The installer generates a unique value; manual
# deployments must set one and never reuse it on shared Redis. Use "legacy" only
# as explicit upgrade compatibility for deployments retaining pre-namespace keys.
REDIS_NAMESPACE=
# Audit events stay in the hot table for this many days, then the explicit
# audit-archive maintenance command moves them to an immutable archive table.
# The archive is retained indefinitely. Keep disabled unless a scheduler is configured.
AUDIT_ARCHIVE_ENABLED=false
AUDIT_RETENTION_DAYS=2555
# Redis outage behavior for authentication failure limiting: fail-closed or fail-open.
AUTH_LIMITER_FAILURE_POLICY=fail-closed
# Requests without trusted ConnectInfo: reject in production or skip only the IP dimension.
AUTH_LIMITER_MISSING_SOURCE_IP=reject
POSTGRES_DB=chenxing_auth
POSTGRES_USER=chenxing
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_RUNTIME_USER=chenxing_runtime
POSTGRES_RUNTIME_PASSWORD=chenxing
# Absolute lifetime of an authenticated browser session. Default: 604800 (7 days).
# Upper bound: 7776000 (90 days); out-of-range values are rejected at startup.
SESSION_TTL_SECONDS=604800
# Idle timeout for an authenticated browser session. Activity renews this
# window, but never moves the absolute SESSION_TTL_SECONDS deadline. Default: 1800 (30 min).
# Upper bound: 2592000 (30 days).
SESSION_IDLE_TIMEOUT_SECONDS=1800
# Maximum active sessions per user. When the limit is reached, the oldest
# active session is revoked before the new one is stored. Default: 5. Upper bound: 1000.
SESSION_MAX_CONCURRENT_SESSIONS=5
OAUTH_CLIENT_MAX_REDIRECT_URIS=10
OAUTH_CLIENT_MAX_REDIRECT_URI_LENGTH=2048
OAUTH_CLIENT_MAX_SCOPES=32
OAUTH_CLIENT_MAX_SCOPE_LENGTH=64
# Server-owned OAuth scope allowlist, comma-separated. Defaults to the standard
# OIDC scopes; custom values are accepted only when explicitly listed here.
OAUTH_CLIENT_ALLOWED_SCOPES=openid,profile,email
RUST_LOG=chenxing_auth=debug,tower_http=debug
# DB connection pool tuning (Issue #84). All optional; defaults shown.
# DB_MAX_CONNECTIONS=10          # Max simultaneous PG connections (default: 10, backward-compatible)
# DB_ACQUIRE_TIMEOUT_SECONDS=5   # Fail fast instead of blocking 30s under pool exhaustion
# DB_IDLE_TIMEOUT_SECONDS=600    # Recycle idle connections (10 min)
# DB_MAX_LIFETIME_SECONDS=1800   # Rotate connections every 30 min to shed server-side state

# ── Issue #267: Server-side statement timeout for the application query pool ───
# PostgreSQL cancels any request-path statement that runs longer than this, so a
# stuck or badly planned query cannot hold a pool connection open indefinitely.
# The HTTP request timeout only abandons the response; the backend keeps running
# and the connection is never returned. The bound must be enforced by PostgreSQL.
#
# Applied per connection via SET on the application pool only. Migrations and the
# `audit-archive` maintenance command use a separate pool with NO statement
# timeout, so long DDL and archive batches are never truncated mid-run.
#
# Unit: milliseconds. Default: 5000 (5s). Accepted range: 100..=60000.
# Values outside that range, or non-integers, FAIL STARTUP instead of silently
# falling back — a wrong bound that looks applied is worse than no bound.
# Set exactly 0 to disable (only when the DB role already carries
# `ALTER ROLE ... SET statement_timeout`); startup logs a warning.
# Keep this below REQUEST_TIMEOUT_SECONDS so the database gives up first.
# DB_STATEMENT_TIMEOUT_MS=5000

# ── Issue #111: Trusted Proxy Configuration ────────────────────────────────────
# Comma-separated list of trusted reverse proxy IPs (IPv4 or IPv6).
# When set, X-Forwarded-For is parsed ONLY if the TCP peer matches a trusted IP.
# Deployment behind Nginx/Traefik MUST set this, otherwise rate limiting degrades
# to a shared quota per proxy IP (self-DoS risk). Leave unset for direct deployment.
# TRUSTED_PROXIES=10.0.0.5,172.17.0.1

# ── Issue #112: Token TTL (Separate from Browser Session TTL) ─────────────────
# OAuth access token lifetime (seconds). Default: 3600 (1 hour).
# Stateless JWT with black-list only at userinfo endpoint; keep short to limit
# revocation exposure. Must be between 1 and 86400 (24h), and no greater than KEY_ROTATION_GRACE_SECONDS.
# ACCESS_TOKEN_TTL_SECONDS=3600
# OIDC ID token lifetime (seconds). Default: 3600 (1 hour).
# Must be between 1 and 86400 (24h), and no greater than KEY_ROTATION_GRACE_SECONDS.
# ID_TOKEN_TTL_SECONDS=3600

# ── Issue #121: Configurable Security Limits ──────────────────────────────────
# Every limit below has a minimum of 1 and an upper bound (issue #260). Values outside
# the range fall back to the default with a warning at startup; the equivalent admin API
# (PUT /api/v1/admin/settings/security-limits) rejects them with 400 instead. These
# thresholds *are* the security control, so an extreme value silently disables it.
# Unauthenticated source IP QPS limit for /oauth/token endpoint. Default: 30, maximum: 1000.
# UNAUTHENTICATED_SOURCE_QPS=30
# Authorization code validity (seconds). Default: 300, maximum: 600 (RFC 6749 §4.1.2).
# AUTHORIZATION_CODE_TTL_SECONDS=300
# Pending authorization request TTL (seconds). User dwell time on consent page.
# Default: 600, maximum: 3600.
# PENDING_REQUEST_TTL_SECONDS=600
# Per-client pending authorization capacity. Default: 20, maximum: 10000.
# MAX_PENDING_REQUESTS_PER_CLIENT=20
# Global pending authorization capacity. Default: 1000, maximum: 1000000.
# MAX_PENDING_REQUESTS_GLOBAL=1000
# Authentication failure sliding window (seconds). Default: 900 (15 min), maximum: 86400 (24h).
# AUTH_FAILURE_WINDOW_SECONDS=900
# Account-level failure threshold per window. Default: 10, maximum: 1000.
# ACCOUNT_FAILURE_LIMIT=10
# Source-IP failure threshold per window. Default: 30, maximum: 10000.
# IP_FAILURE_LIMIT=30
# TOTP ticket cumulative failure threshold (not windowed). Default: 5, maximum: 100.
# TOTP_TICKET_FAILURE_LIMIT=5
# External OAuth login state TTL (seconds). Default: 600, maximum: 3600.
# EXTERNAL_LOGIN_STATE_TTL_SECONDS=600
# External OAuth state rate-limit window (seconds). Default: 60, maximum: 3600.
# EXTERNAL_LOGIN_STATE_RATE_WINDOW_SECONDS=60
# External OAuth state rate-limit per source IP per window. Default: 30, maximum: 10000.
# EXTERNAL_LOGIN_STATE_RATE_LIMIT=30
# External OAuth state global pending capacity. Default: 10000, maximum: 1000000.
# EXTERNAL_LOGIN_STATE_MAX_PENDING=10000
