# Explicit override fragment for local HTTP development on 127.0.0.1:3000.
# Apply these values to a local .env based on .env.example. Never use them for
# a production or non-loopback deployment.
APP_HOST=127.0.0.1
APP_PORT=3000
COOKIE_SECURE=false
WEBAUTHN_RP_ID=127.0.0.1
WEBAUTHN_ORIGIN=http://127.0.0.1:3000
